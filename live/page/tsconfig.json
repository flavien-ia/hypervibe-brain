{
  // Type checking of the page, in development only (`pnpm check`, or
  // `pnpm check:page` for the page alone). The modules are plain files the
  // browser loads as they are; what the server answers is typed by
  // ../contract.d.ts.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["**/*.js", "../contract.d.ts"]
}
